# Qualtrics mode: "mock" (default, uses localStorage) or "live" (uses Qualtrics API)
VITE_QUALTRICS_MODE=mock

# Qualtrics credentials (only needed for live mode, set in Netlify dashboard)
# QUALTRICS_API_TOKEN=your_api_token
# QUALTRICS_SURVEY_ID=your_survey_id
# QUALTRICS_DATACENTER=iad1

# PostHog analytics (optional overrides; key defaults to the project key in code)
# VITE_POSTHOG_KEY=phc_your_project_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Chatbot pilot (server-side only; set in the Netlify dashboard, never committed).
# Required for the /chatbot page. The key stays on the serverless function.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-sonnet-5):
# ANTHROPIC_MODEL=claude-sonnet-5
